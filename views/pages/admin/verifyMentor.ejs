<section class="mt-5">
  <h1 class="text-3xl tracking-tight font-bold mb-3">Verify Mentor</h1>
  <table class="w-full bg-white border">
    <thead>
      <tr>
        <th class="py-2 px-4 border-b border-gray-200 bg-gray-100">ID</th>
        <th class="py-2 px-4 border-b border-gray-200 bg-gray-100">Name</th>
        <th class="py-2 px-4 border-b border-gray-200 bg-gray-100">Email</th>
        <th class="py-2 px-4 border-b border-gray-200 bg-gray-100">Phone Number</th>
        <th class="py-2 px-4 border-b border-gray-200 bg-gray-100">Verified</th>
        <th class="py-2 px-4 border-b border-gray-200 bg-gray-100">Actions</th>
      </tr>
    </thead>
    <tbody id="mentorTableBody">
      <!-- Mentor rows will be dynamically inserted here -->
    </tbody>
  </table>
</section>

<!-- Loading Div -->
<div id="loadingDiv" class="fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center hidden">
  <div class="loader"></div>
</div>

<style>
  .loader {
    border: 8px solid #f3f3f3;
    border-top: 8px solid #3498db;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    animation: spin 2s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  #loadingDiv.fade-in {
    animation: fadeIn 0.5s forwards;
  }

  #loadingDiv.fade-out {
    animation: fadeOut 0.5s forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mentorTableBody = document.getElementById('mentorTableBody');
    const loadingDiv = document.getElementById('loadingDiv');

    // Function to fetch mentor data
    async function fetchMentors() {
      try {
        const response = await fetch('/api/v1/mentors');
        const mentors = await response.json();
        updateMentorTable(mentors);
      } catch (error) {
        console.error('Error fetching mentors:', error);
      }
    }

    // Function to update the mentor table
    function updateMentorTable(mentors) {
      mentorTableBody.innerHTML = '';
      mentors.forEach(mentor => {
        const row = document.createElement('tr');
        row.innerHTML = `
          <td class="py-2 px-4 border-b border-gray-200">${mentor.id}</td>
          <td class="py-2 px-4 border-b border-gray-200">${mentor.name}</td>
          <td class="py-2 px-4 border-b border-gray-200">${mentor.email}</td>
          <td class="py-2 px-4 border-b border-gray-200">${mentor.phone_number}</td>
          <td class="py-2 px-4 border-b border-gray-200">${mentor.is_verified ? 'Yes' : 'No'}</td>
          <td class="py-2 px-4 border-b border-gray-200">
            ${mentor.is_verified ? '' : `
              <form class="verifyForm" data-id="${mentor.id}">
                <button type="submit" class="bg-blue-500 text-white p-2 px-4 rounded-md w-full">Verify</button>
              </form>
            `}
          </td>
        `;
        mentorTableBody.appendChild(row);
      });

      // Attach event listeners to the dynamically created forms
      document.querySelectorAll('.verifyForm').forEach(form => {
        form.addEventListener('submit', handleFormSubmit);
      });
    }

    // Handle form submission
    async function handleFormSubmit(event) {
      event.preventDefault();

      const form = event.target;
      const mentorId = form.getAttribute('data-id');

      // Show loading div
      loadingDiv.classList.remove('hidden');
      loadingDiv.classList.add('fade-in');

      try {
        const response = await fetch('/api/v1/admin/mentor/verify', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ id: mentorId })
        });

        // Check if the response is JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.indexOf('application/json') !== -1) {
          const result = await response.json();
          if (result.status === 'success') {
            showAlert('Mentor verified successfully!', 'success');
            fetchMentors(); // Refresh the mentor data
          } else {
            showAlert('Failed to verify mentor.', 'failed');
          }
        } else {
          console.error('Unexpected response format:', await response.text());
          showAlert('Unexpected response format. Please try again.', 'failed');
        }
      } catch (error) {
        console.error('Error verifying mentor:', error);
        showAlert('An error occurred. Please try again.', 'failed');
      } finally {
        // Hide loading div
        loadingDiv.classList.remove('fade-in');
        loadingDiv.classList.add('fade-out');
        setTimeout(() => {
          loadingDiv.classList.add('hidden');
          loadingDiv.classList.remove('fade-out');
        }, 500);
      }
    }

    // Fetch mentors on page load
    fetchMentors();
  });
</script>