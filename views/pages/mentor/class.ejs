<h1 class="text-3xl font-bold tracking-tight">Class Management</h1>

<!-- CREATE CLASS -->
<section>
  <h2 class="text-2xl font-bold mt-4">Create Class</h2>
  <form id="createClassForm" class="w-full flex flex-col items-start">
    <label for="name">Name</label>
    <input type="text" name="name" id="name" class="border border-gray-400 p-1 rounded-md mb-2" required>
    <label for="description">Description</label>
    <textarea name="description" id="description" class="border border-gray-400 p-1 rounded-md mb-2" required></textarea>
    <button type="submit" class="bg-blue-500 text-white p-2 px-10 rounded-md w-full">Create</button>
  </form>
</section>